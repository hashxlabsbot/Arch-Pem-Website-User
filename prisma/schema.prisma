// ─────────────────────────────────────────────────────────────────────────
// SHARED DATABASE — these models MIRROR the admin app (Arc-Pem-Admin), which
// owns the schema and its migrations. This website reads/writes the SAME
// PostgreSQL database.
//
// ⚠️  NEVER run `prisma migrate` or `prisma db push` from this project.
//     Doing so would try to make the DB match this (subset) schema and would
//     DROP the admin-only tables (Client, License, ApiKey, ActivityLog) and
//     their columns/indexes. Only ever run `prisma generate` here.
//     Schema changes are made in Arc-Pem-Admin and migrated from there.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  tokenVersion Int      @default(0)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  // End of the current one-year license term. OWNED by the admin app, which sets
  // it on paid activation; this app only READS it (mirror field — never migrate
  // from here). Null = no active paid license.
  planExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, status, createdAt])
  @@index([planId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PendingPayment {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  planName  String
  amount    Float
  utr       String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  period      String   @default("month")
  description String
  features    String
  maxProjects Int      @default(10)
  maxUsers    Int      @default(1)
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Blog / CMS — authored in Arc-Pem-Admin (which owns the migration), read here.
// This is a mirror; run only `prisma generate` in this project (see warning above).
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  contentMarkdown String
  category        String
  tags            String[]
  authorName      String?
  authorRole      String?
  coverImage      String?
  coverImageAlt   String?
  seoTitle        String?
  featured        Boolean   @default(false)
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  updatedDate     DateTime?
  relatedTools    String[]
  relatedPosts    String[]
  faq             Json?
  howto           Json?
  viewCount       Int       @default(0) // denormalised all-time total (cheap sort/display)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// Per-day rollup of blog traffic. Written by /api/blog/view; read by the admin
// analytics dashboard. (Migration owned by the Arc-Pem-Admin repo.)
model BlogPostView {
  id      String   @id @default(cuid())
  slug    String
  date    DateTime @db.Date
  views   Int      @default(0)
  uniques Int      @default(0)

  @@unique([slug, date])
  @@index([slug])
}

// One row per (post, day, visitor) — bounded de-dup that drives the `uniques`
// (reach) counter. Insert fails on the composite PK for a repeat visitor.
model BlogPostVisit {
  slug        String
  date        DateTime @db.Date
  visitorHash String

  @@id([slug, date, visitorHash])
}
