// ─────────────────────────────────────────────────────────────────────────
// SHARED DATABASE — these models MIRROR the admin app (Arc-Pem-Admin), which
// owns the schema and its migrations. This website reads/writes the SAME
// PostgreSQL database.
//
// ⚠️  NEVER run `prisma migrate` or `prisma db push` from this project.
//     Doing so would try to make the DB match this (subset) schema and would
//     DROP the admin-only tables (Client, License, ApiKey, ActivityLog) and
//     their columns/indexes. Only ever run `prisma generate` here.
//     Schema changes are made in Arc-Pem-Admin and migrated from there.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("USER")
  status       String   @default("ACTIVE")
  tokenVersion Int      @default(0)
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id])
  // End of the current one-year license term. OWNED by the admin app, which sets
  // it on paid activation; this app only READS it (mirror field — never migrate
  // from here). Null = no active paid license.
  planExpiresAt DateTime?
  webSubscription WebSubscription?
  billingProfile  BillingProfile?
  invoices        Invoice[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, status, createdAt])
  @@index([planId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PendingPayment {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  planName  String
  amount    Float
  utr       String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  period      String   @default("month")
  description String
  features    String
  maxProjects Int      @default(10)
  maxUsers    Int      @default(1)
  // WEB plans: site seats included (Site engineer, Supervisor). 100000 = unlimited.
  maxSiteUsers Int     @default(0)
  isActive    Boolean  @default(true)
  // DESKTOP (machine license, User.planId) | WEB (ARC PEM Web firm subscription). Mirror — admin owns it.
  product     String   @default("DESKTOP")
  // WEB plans: SOLO | STUDIO | BUSINESS | ENTERPRISE, the app's tier.
  tier        String?
  users       User[]
  webSubscriptions WebSubscription[]
  razorpayPlans    RazorpayPlan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([product, isActive])
}

// ── ARC PEM Web (app.arcpem.com) — mirrors of admin-owned tables (see warning above) ──

model WebSubscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName         String
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           String    @default("ACTIVE")
  currentPeriodEnd DateTime?
  seatLimit        Int?
  projectLimit     Int?
  // MONTH | YEAR. Renewed automatically while autoRenew is true (a Razorpay subscription is running).
  billingInterval  String    @default("YEAR")
  autoRenew        Boolean   @default(false)
  siteSeatLimit    Int?
  // Add-on seats bought with the current subscription, on top of the plan's.
  extraSeats       Int       @default(0)
  extraSiteSeats   Int       @default(0)
  // Set while the firm is on its free trial (no payment taken yet).
  trialEndsAt      DateTime?
  razorpaySubscriptionId String? @unique
  payments         WebSubscriptionPayment[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, currentPeriodEnd])
}

/// The Razorpay plan object behind each (plan, billing interval, price); a price change gets a new one.
model RazorpayPlan {
  id              String   @id
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  billingInterval String
  amountPaise     Int
  createdAt       DateTime @default(now())

  @@unique([planId, billingInterval, amountPaise])
}

model WebSubscriptionPayment {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   WebSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentRef     String          @unique
  planId         String
  amount         Float
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime        @default(now())

  @@index([subscriptionId, createdAt])
}

model WebhookOutbox {
  id            String    @id
  type          String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model OidcAuthCode {
  codeHash      String   @id
  userId        String
  clientId      String
  redirectUri   String
  scope         String
  nonce         String?
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

// Read here for the firm name on a new web subscription. Mirror — admin owns it.
model BillingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName    String
  gstin        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  stateCode    String
  pincode      String
  country      String   @default("India")
  phone        String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// GST invoices, issued by the admin app for every payment (see its lib/invoice.ts). Read-only here: customers
// list and download theirs from the dashboard.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Links the approved PendingPayment that triggered this invoice (one invoice per payment).
  paymentId     String?  @unique
  planName      String

  // Snapshot of buyer details at issue time (so later profile edits never alter past invoices).
  buyerName      String
  buyerGstin     String?
  buyerAddress   String
  buyerStateCode String

  // Snapshot of seller details at issue time.
  sellerName      String
  sellerGstin     String
  sellerAddress   String
  sellerStateCode String

  placeOfSupply String
  hsnSac        String
  taxRate       Float
  taxableAmount Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  total         Float
  currency      String   @default("INR")
  // Rendered PDF bytes, served on download.
  pdf           Bytes
  issuedAt      DateTime @default(now())

  @@index([userId])
  @@index([issuedAt])
}

// Demo requests submitted from the "Book a Free Demo" modal — written here,
// managed in Arc-Pem-Admin → Demo Bookings. Admin owns the migration (see
// warning above); this is a mirror, run only `prisma generate` in this project.
model DemoBooking {
  id              String   @id @default(cuid())
  name            String
  email           String
  whatsapp        String
  company         String?
  role            String?
  teamSize        String?
  preferredDate   String?
  preferredTime   String?
  meetLink        String?
  calendarEventId String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

// Blog / CMS — authored in Arc-Pem-Admin (which owns the migration), read here.
// This is a mirror; run only `prisma generate` in this project (see warning above).
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String
  contentMarkdown String
  category        String
  tags            String[]
  authorName      String?
  authorRole      String?
  coverImage      String?
  coverImageAlt   String?
  seoTitle        String?
  featured        Boolean   @default(false)
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  updatedDate     DateTime?
  relatedTools    String[]
  relatedPosts    String[]
  faq             Json?
  howto           Json?
  viewCount       Int       @default(0) // denormalised all-time total (cheap sort/display)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

// Per-day rollup of blog traffic. Written by /api/blog/view; read by the admin
// analytics dashboard. (Migration owned by the Arc-Pem-Admin repo.)
model BlogPostView {
  id      String   @id @default(cuid())
  slug    String
  date    DateTime @db.Date
  views   Int      @default(0)
  uniques Int      @default(0)

  @@unique([slug, date])
  @@index([slug])
}

// One row per (post, day, visitor) — bounded de-dup that drives the `uniques`
// (reach) counter. Insert fails on the composite PK for a repeat visitor.
model BlogPostVisit {
  slug        String
  date        DateTime @db.Date
  visitorHash String

  @@id([slug, date, visitorHash])
}

/// Billing rules editable from admin Settings (one row, id 'default'). Mirrored in the customer website's schema.
model BillingSettings {
  id                   String   @id @default("default")
  seatAddonMonthly     Int      @default(599)
  siteSeatAddonMonthly Int      @default(199)
  annualBilledMonths   Int      @default(10)
  trialDays            Int      @default(14)
  maxAddonSeats        Int      @default(50)
  updatedAt            DateTime @default(now()) @updatedAt
  updatedBy            String?
}
