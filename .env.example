# Shared PostgreSQL — the SAME database as the admin app (Arc-Pem-Admin).
# The admin owns migrations; never run prisma migrate/db push from this project.
DATABASE_URL="postgresql://user:password@host:5432/arcpem?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/arcpem?schema=public"

NEXTAUTH_SECRET="replace-with-a-strong-random-secret"   # openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3001"

# Google sign-in (console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application). Authorized redirect URI:
# {NEXTAUTH_URL}/api/auth/callback/google (e.g. http://localhost:3001/api/auth/callback/google
# in dev, https://yourdomain.com/api/auth/callback/google in prod).
# Leave both blank to hide the "Continue with Google" button entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin app — used for the registration API call and the ADMIN redirect
ADMIN_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_API="http://localhost:3000"

# Hosts allowed for Server Actions (comma-separated)
ALLOWED_ORIGINS="localhost:3001"

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook signing secret — set the SAME value here and in the Razorpay dashboard
# webhook config (Settings → Webhooks). Subscribe to payment.captured / order.paid.
RAZORPAY_WEBHOOK_SECRET=""

# SMTP — the official mailbox emails (OTP, password reset, demo requests,
# payment receipts) are sent from. Hostinger example shown; any SMTP account works.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@yourdomain.com"
SMTP_PASS=""
MAIL_FROM="info@yourdomain.com"
MAIL_FROM_NAME="ARC PEM"

# Demo bookings — comma-separated internal recipients for lead notifications.
DEMO_LEADS_EMAILS="info@yourdomain.com"

# Google Calendar API — creates a Google Meet link when a demo is booked.
# Uses the SAME OAuth client as Google sign-in above (Calendar API must be
# enabled on that Google Cloud project). The refresh token is obtained once,
# per calendar-owning account, via `node scripts/get-calendar-refresh-token.mjs`.
# Leave GOOGLE_CALENDAR_REFRESH_TOKEN blank to skip Meet-link generation —
# bookings still work, just without an auto-generated link.
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# Upstash Redis (REST) — REQUIRED in production for cross-instance rate
# limiting and OTP storage. Falls back to in-memory if unset (dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Installer download paths (local file) or URLs (remote redirect)
DOWNLOAD_PATH_WIN=""
DOWNLOAD_PATH_MAC=""
DOWNLOAD_URL_WIN=""
DOWNLOAD_URL_MAC=""

# Vapi (vapi.ai) — public key for the voice AI assistant widget on marketing
# pages. Get it from the Vapi dashboard → API Keys → Public. Safe to expose
# client-side (it can only start calls, not read your account). Leave blank
# to hide the widget entirely.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""

# Google Analytics 4 — Measurement ID from analytics.google.com
# (Admin → Data Streams → your web stream → Measurement ID, looks like "G-XXXXXXXXXX").
# Safe to expose client-side. Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console — HTML tag verification code only (not the full <meta> tag).
# From search.google.com/search-console → Settings → Ownership verification → HTML tag
# → copy just the "content" value. Leave blank until you verify the property.
GOOGLE_SITE_VERIFICATION=""

# From bing.com/webmasters → Settings → Verify ownership → HTML Meta Tag → the "content" value of msvalidate.01.
# Bing's index also powers ChatGPT search and Microsoft Copilot answers, so verify it as well as Google.
BING_SITE_VERIFICATION=""
# From webmaster.yandex.com → Verify rights → Meta tag → the "content" value. Optional.
YANDEX_SITE_VERIFICATION=""

# IndexNow (Bing, Yandex, Seznam, Naver): pings search engines the moment a page changes. Any 32-char hex string
# works (e.g. `openssl rand -hex 16`); it is served publicly at /indexnow-key.txt. Leave blank to disable.
INDEXNOW_KEY=""

# Shared secret for POST /api/revalidate (blog publish webhook from the admin app). Must match the admin app.
REVALIDATE_SECRET=

# Live blog preview: verify admin preview tokens; allow the admin origin to iframe /blog/preview
PREVIEW_SECRET=
ADMIN_ORIGIN=http://localhost:3000

# ── ARC PEM Web (app.arcpem.com) ─────────────────────────────────────────────
# This site is the web app's OpenID Connect provider (firm owners sign in to the web app with their ARC PEM
# account) and pushes every web subscription change to it. The web app must be configured with the matching values
# (ARCPEM_ACCOUNTS_ISSUER = this site's NEXTAUTH_URL, same client id/secret and webhook secret).
WEB_APP_URL="http://localhost:3002"
# openssl rand -hex 32 — same value as ARCPEM_ACCOUNTS_WEBHOOK_SECRET in the web app (and in Arc-Pem-Admin).
WEB_APP_WEBHOOK_SECRET=
OIDC_CLIENT_ID="arcpem-web"
# openssl rand -hex 32 — same value as ARCPEM_ACCOUNTS_CLIENT_SECRET in the web app.
OIDC_CLIENT_SECRET=
# Exact redirect URIs, comma-separated. Defaults to {WEB_APP_URL}/api/auth/callback/arcpem.
OIDC_REDIRECT_URIS=
# RSA private key (PEM, \n-escaped on one line) that signs ID tokens. REQUIRED in production; a throwaway key is
# generated in development. Create: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
OIDC_PRIVATE_KEY=
# Bearer secret for GET /api/cron/web-app-outbox (retries undelivered updates). Schedule it every 5 minutes.
CRON_SECRET=
# Public link to the web app used by the site's "Sign in → ARC PEM Web" and "Open ARC PEM Web" links.
NEXT_PUBLIC_WEB_APP_URL="https://app.arcpem.com"
