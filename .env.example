# Shared PostgreSQL — the SAME database as the admin app (Arc-Pem-Admin).
# The admin owns migrations; never run prisma migrate/db push from this project.
DATABASE_URL="postgresql://user:password@host:5432/arcpem?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/arcpem?schema=public"

NEXTAUTH_SECRET="replace-with-a-strong-random-secret"   # openssl rand -hex 32
NEXTAUTH_URL="http://localhost:3001"

# Admin app — used for the registration API call and the ADMIN redirect
ADMIN_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_API="http://localhost:3000"

# Hosts allowed for Server Actions (comma-separated)
ALLOWED_ORIGINS="localhost:3001"

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Brevo — used for OTP and password-reset emails (app.brevo.com → API Keys)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@yourdomain.com"

# Upstash Redis (REST) — REQUIRED in production for cross-instance rate
# limiting and OTP storage. Falls back to in-memory if unset (dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Installer download paths (local file) or URLs (remote redirect)
DOWNLOAD_PATH_WIN=""
DOWNLOAD_PATH_MAC=""
DOWNLOAD_URL_WIN=""
DOWNLOAD_URL_MAC=""
